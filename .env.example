# Runtime environment
NODE_ENV=development
LOG_LEVEL=info

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Lumina is intentionally restricted to one Discord server.
DISCORD_GUILD_ID=

# AI provider routing
PRIMARY_AI_PROVIDER=gemini
FALLBACK_AI_PROVIDERS=groq,openrouter
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=450

# Conversation management
CONVERSATION_INACTIVITY_HOURS=24

# Lumina personality
# Optional. Leave blank to use the built-in default personality.
LUMINA_PERSONALITY=

# AI access restrictions
# Optional dedicated channel. Lumina can respond automatically in this channel.
AI_CHANNEL_ID=
# When true, Lumina only responds to messages in AI_CHANNEL_ID in the configured server.
AI_CHANNEL_ONLY=false
# Optional role required to use Lumina. Server administrators can always use Lumina.
AI_ROLE_ID=

# Automatic memory behavior
MEMORY_BEHAVIOR=conservative

# Rate limits
# Requests per user and per provider within RATE_WINDOW_SECONDS.
RATE_USER_REQUESTS=10
RATE_PROVIDER_REQUESTS=60
RATE_WINDOW_SECONDS=3600

# AI provider API keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# AI models
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# AI context and summarization limits
CONTEXT_MAX_TOKENS=6000
CONTEXT_RECENT_MESSAGES=20
CONTEXT_MAX_SUMMARY_TOKENS=1000
SUMMARY_TRIGGER_MESSAGES=30
SUMMARY_SOURCE_MESSAGES=60
SUMMARY_RECENT_MESSAGES_TO_KEEP=12
SUMMARY_MAX_TOKENS=700
