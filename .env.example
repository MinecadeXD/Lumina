# Runtime environment
NODE_ENV=development
LOG_LEVEL=info

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# AI provider routing
PRIMARY_AI_PROVIDER=gemini
FALLBACK_AI_PROVIDERS=groq,openrouter
AI_TIMEOUT_MS=30000

# Conversation management
CONVERSATION_INACTIVITY_HOURS=24

# AI context and summarization limits
CONTEXT_MAX_TOKENS=6000
CONTEXT_RECENT_MESSAGES=20
CONTEXT_MAX_SUMMARY_TOKENS=1000
SUMMARY_TRIGGER_MESSAGES=30
SUMMARY_SOURCE_MESSAGES=60
SUMMARY_RECENT_MESSAGES_TO_KEEP=12
SUMMARY_MAX_TOKENS=700

# AI provider API keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# AI models
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_MODEL=openrouter/free
