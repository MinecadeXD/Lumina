# Runtime environment
NODE_ENV=development
LOG_LEVEL=info

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# AI provider routing
PRIMARY_AI_PROVIDER=gemini
FALLBACK_AI_PROVIDERS=groq,openrouter
AI_TIMEOUT_MS=30000

# AI provider API keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# AI models
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=openai/gpt-oss-120b:free
